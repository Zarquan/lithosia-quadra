# Point this clone at the repository's versioned hooks.
#
# core.hooksPath lives in .git/config, which is not versioned, so the DCO
# guard has to be switched on once per clone. The wrapper bin/agent-commit
# works without this; the hook only adds enforcement.
#
#   bin/setup-agent-git
#
# Re-running is harmless. The absolute path is written because a relative
# core.hooksPath would be resolved against the wrong directory.

set -euo pipefail

root=$(git rev-parse --show-toplevel)
hooks="${root}/agents/hooks"

if [ ! -d "$hooks" ]; then
    echo "setup-agent-git: no hooks directory at ${hooks}" >&2
    exit 2
fi

chmod +x "${hooks}/commit-msg"
git config core.hooksPath "$hooks"

echo "setup-agent-git: core.hooksPath -> $(git config core.hooksPath)"
