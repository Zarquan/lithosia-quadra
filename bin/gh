# Run the GitHub CLI with a token read from a mounted secret file.
#
#   bin/gh issue list --repo Zarquan/lithosia-quadra
#
# DSH removes credential-shaped variables from the environment of every process
# it spawns (`/KEY|PASSWORD|SECRET|TOKEN/i`), so a token provided to the
# container as an environment variable never reaches an agent shell. The token
# is mounted as a file instead - a podman secret defaults to `type=mount`, which
# writes one at /run/secrets/<name> - and is assigned here, inside the shell,
# after the scrub has already run.
#
# There is one secret per organisation, because the permissions are separate:
#
#   /run/secrets/dsh-github-token-zarquan    the Zarquan repositories
#   /run/secrets/dsh-github-token-uksrc      the uksrc repositories
#
# The default is chosen explicitly rather than inferred from --repo: a wrong
# guess would be silent, and the override is one word. Point GH_SECRET_FILE at
# the other token for the other organisation:
#
#   GH_SECRET_FILE=/run/secrets/dsh-github-token-uksrc bin/gh pr create ...
#
# Set GH_TOKEN yourself and it is passed through untouched, and GH_SECRET_FILE
# overrides the location. See AGENTS.md, "Git remotes and the GitHub token".

set -euo pipefail

default_secret=/run/secrets/dsh-github-token-zarquan
uksrc_secret=/run/secrets/dsh-github-token-uksrc

secret=${GH_SECRET_FILE:-$default_secret}

if ! command -v gh >/dev/null 2>&1; then
    echo "gh: the GitHub CLI is not installed in this container" >&2
    exit 2
fi

# An explicit token wins, so this wrapper composes with a caller's own setup.
if [ -n "${GH_TOKEN:-}" ]; then
    exec gh "$@"
fi

if [ ! -r "$secret" ]; then
    echo "gh: no token to use; '${secret}' is missing or unreadable" >&2
    echo "gh: the tokens are mounted at:" >&2
    echo "gh:   ${default_secret}  (Zarquan repositories, the default)" >&2
    echo "gh:   ${uksrc_secret}  (uksrc repositories)" >&2
    echo "gh: point GH_SECRET_FILE at one of them, or set GH_TOKEN" >&2
    exit 2
fi

exec env GH_TOKEN="$(cat "$secret")" gh "$@"
