# DCO guard for commits made inside an agent session.
#
# A commit created from a DSH session must come from bin/agent-commit, which
# sets GIT_AUTHOR_EMAIL to the agent and leaves the committer - and therefore
# the Signed-off-by trailer - as the human. This hook refuses anything else.
#
# DSH_SESSION_ID is injected into every agent shell invocation and is absent
# from a human's own shell, which is what distinguishes the two. Bypass with
# `git commit --no-verify` if a human needs to override.
#
# Enable per clone with bin/setup-agent-git.

set -euo pipefail

message_file=$1

# Never police a human's own shell.
if [ -z "${DSH_SESSION_ID:-}" ]; then
    exit 0
fi

root=$(git rev-parse --show-toplevel)

# Resolve the expected agent identity exactly as bin/agent-commit does:
# environment first, then the committed file.
agent_email=${AGENT_GIT_EMAIL:-}
if [ -z "$agent_email" ] && [ -r "${root}/agents/git-identity.env" ]; then
    # shellcheck source=/dev/null
    . "${root}/agents/git-identity.env"
    agent_email=${AGENT_GIT_EMAIL:-}
fi

# An agent session that did not go through the wrapper leaves the author unset.
if [ -n "$agent_email" ] && [ "${GIT_AUTHOR_EMAIL:-}" != "$agent_email" ]; then
    echo "commit-msg: agent commits must use bin/agent-commit (author is '${GIT_AUTHOR_EMAIL:-unset}')" >&2
    exit 1
fi

human_email=$(git config user.email || true)
if [ -z "$human_email" ]; then
    echo "commit-msg: no user.email configured to sign off with" >&2
    exit 1
fi

# Exact match on the address, so no regex metacharacter in an email can loosen it.
if ! awk -v who="<${human_email}>" '
    /^[Ss]igned-off-by:/ && index($0, who) { found = 1 }
    END { exit found ? 0 : 1 }
' "$message_file"; then
    echo "commit-msg: missing 'Signed-off-by: <${human_email}>'; use bin/agent-commit" >&2
    exit 1
fi
