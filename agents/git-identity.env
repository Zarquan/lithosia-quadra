# The identity recorded as the AUTHOR of commits made by an AI agent.
#
# bin/agent-commit exports these as GIT_AUTHOR_NAME and GIT_AUTHOR_EMAIL, so
# the agent is credited as the author while the repository's configured user
# (see .git/config) remains the COMMITTER. That matters for the DCO: the
# Signed-off-by trailer added by `git commit --signoff` names the committer,
# so the person approving the commit is the one certifying it.
#
# Environment variables of the same name override these values.
#
# See AGENTS.md, "Commit identity and sign-off".

AGENT_GIT_NAME="DeepSeek Harness"
AGENT_GIT_EMAIL="zrq-github+dsh@metagrid.co.uk"
